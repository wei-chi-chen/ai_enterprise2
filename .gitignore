# Python 暫存與虛擬環境
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.history/

# 系統與編輯器暫存
.vscode/
.idea/
*.tmp
*.log

# 敏感設定檔
.cloud_config.json
.env

# 企業工作區：徹底排除任務、交付成果與歷史紀錄
enterprise_workspace/02_tasks/**
enterprise_workspace/03_delivery/**
enterprise_workspace/04_history/**

# 員工工作區的動態狀態檔
enterprise_workspace/01_staff/employee_status.json
enterprise_workspace/01_staff/live_status.json
enterprise_workspace/01_staff/.cloud_config.json

# 保留各目錄的 .gitkeep，確保空資料夾結構可被 Git 建立
!enterprise_workspace/**/.gitkeep